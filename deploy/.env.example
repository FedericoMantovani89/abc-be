# ============================================================================
# ABC Musical Company — configurazione ambiente
#
# Copia questo file in `running\.env` (cartella fratello di abc-be e abc-fe,
# non versionata) e avvia con:
#   docker compose -f deploy\docker-compose.yml --env-file ..\running\.env up -d
#
# Per spostare il sito su un altro PC: copia i due repo (abc-be, abc-fe) e la
# cartella running\.env, poi riesegui il comando sopra. Per portare anche i
# dati, vedi la sezione "Backup e ripristino" nel README.md.
# ============================================================================

# ----------------------------------------------------------------------------
# Database (il container Postgres viene creato con questi valori)
# ----------------------------------------------------------------------------
DB_NAME=abc
DB_USER=abc
DB_PASSWORD=cambiami-password-db

# ----------------------------------------------------------------------------
# Sicurezza — genera valori nuovi con: openssl rand -base64 32
# (su Windows: usa Git Bash, oppure https://generate-secret.vercel.app/32)
# ----------------------------------------------------------------------------
JWT_SECRET=genera-con-openssl-rand-base64-32
REMEMBER_ME_KEY=genera-con-openssl-rand-base64-32
NEXTAUTH_SECRET=genera-con-openssl-rand-base64-32

# Durata JWT in secondi (1 ora; 30 giorni con "ricordami")
JWT_EXPIRATION=3600
JWT_REMEMBERME_EXPIRATION=2592000

# ----------------------------------------------------------------------------
# Admin iniziale — creato automaticamente al primo avvio se non esiste.
# Cambia la password dopo il primo login... o almeno cambiala qui prima di avviare.
# ----------------------------------------------------------------------------
ADMIN_EMAIL=admin@esempio.it
ADMIN_PASSWORD=cambiami-password-admin

# ----------------------------------------------------------------------------
# Email — Gmail SMTP con App Password (NON la password normale di Gmail).
# Per rigenerarla: Google Account -> Sicurezza -> Verifica in 2 passaggi
#   -> Password per le app -> crea una password per "Mail".
# https://myaccount.google.com/apppasswords
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua-email@gmail.com
SMTP_PASSWORD=app-password-gmail-16-caratteri

# ----------------------------------------------------------------------------
# OAuth2 — Google e Facebook.
# I redirect URI registrati nelle console devono includere:
#   Google:   http://localhost:8080/login/oauth2/code/google
#   Facebook: http://localhost:8080/login/oauth2/code/facebook
# Google Console:  https://console.cloud.google.com/apis/credentials
# Facebook Dev:    https://developers.facebook.com -> App -> Facebook Login -> Settings
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=il-tuo-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=il-tuo-google-client-secret
FACEBOOK_CLIENT_ID=il-tuo-facebook-app-id
FACEBOOK_CLIENT_SECRET=il-tuo-facebook-app-secret

# ----------------------------------------------------------------------------
# URL pubblici — in locale lasciare così. Se esponi il sito su internet,
# sostituisci con i domini reali (e aggiorna i redirect URI OAuth).
# ----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

# Upload a chunk: dimensione di ogni chunk (MB) e ore prima che una sessione
# di upload incompleta venga ripulita automaticamente.
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_SESSION_TTL_HOURS=24
