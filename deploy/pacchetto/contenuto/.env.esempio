# ============================================================================
# Sito ABC Musical Company — file dei SEGRETI (.env)
#
# Come si usa (lo fa il Referente tecnico di ABC, sul server):
#   - la prima volta che lanci  bash script/installa.sh  questo file viene copiato in
#     /opt/abc-sito/.env (permessi 600). Poi lo compili con:  nano /opt/abc-sito/.env
#   - compila tutti i valori segnati con (*) e rilancia installa.sh.
#
# Il file .env resta SOLO sul server: non si manda per email, non si mette su chat, non si copia
# in nessuna cartella condivisa. Una copia va nel gestore di password di ABC.
# Tutti i valori segreti qui sotto sono VUOTI: li generate voi, nessun altro li conosce.
# Dopo ogni modifica al .env:  bash /opt/abc-sito/script/riavvia.sh
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Segreti da GENERARE (*)
#    Per ognuno lancia il comando indicato e incolla il risultato dopo il segno "=".
#    Senza spazi e senza virgolette. Vanno generati UNA volta sola: cambiarli dopo
#    disconnette tutti gli utenti (JWT_SECRET, NEXTAUTH_SECRET, REMEMBER_ME_KEY)
#    o impedisce l'avvio (DB_PASSWORD, vedi INSTALLA.md).
# ----------------------------------------------------------------------------
# Comando:  openssl rand -base64 48 | tr -d '\n=+/'
JWT_SECRET=
# Comando:  openssl rand -base64 48 | tr -d '\n=+/'
NEXTAUTH_SECRET=
# Comando:  openssl rand -base64 48 | tr -d '\n=+/'
REMEMBER_ME_KEY=
# Comando:  openssl rand -base64 32 | tr -d '\n=+/'
DB_PASSWORD=

# Nome del database e dell'utente: si lasciano cosi'
DB_NAME=abc
DB_USER=abc

# ----------------------------------------------------------------------------
# 2. Primo amministratore (*)
#    Creato al primo avvio se non esiste. E' una persona di ABC (non Federico).
#    Cambia la password dal sito dopo il primo accesso.
# ----------------------------------------------------------------------------
ADMIN_EMAIL=
# Comando:  openssl rand -base64 18 | tr -d '\n=+/'
ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# 3. Posta del sito: SMTP di Aruba (*)
#    Il mittente deve essere uguale all'utente SMTP, altrimenti Aruba rifiuta le email.
#    Se cambiate la password della casella info@, cambiatela anche qui.
# ----------------------------------------------------------------------------
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=info@attoriballerinicantanti.it
SMTP_PASSWORD=
MAIL_FROM=info@attoriballerinicantanti.it
MAIL_FROM_NAME=ABC Musical Company
# MAIL_REPLY_TO=

# ----------------------------------------------------------------------------
# 4. Accesso con Google e Facebook (*)
#    Le chiavi le crea ABC (Tappa 3 della checklist). Facoltative: se per ora non le avete,
#    lasciate vuoto. Il sito parte lo stesso; l'accesso con quel servizio resta spento (per attivarlo
#    servono ID e segreto) e chi clicca il pulsante torna al login con un errore chiaro.
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# 5. Indirizzo del sito: gia' impostato, non si cambia
# ----------------------------------------------------------------------------
APP_BASE_URL=https://www.attoriballerinicantanti.it
APP_FRONTEND_URL=https://www.attoriballerinicantanti.it

# Numero RUNTS di ABC. Per cambiarlo scrivi qui il nuovo valore (o in /config/sito.json per il
# frontend) e riavvia: non serve una nuova versione del pacchetto.
ASSOCIAZIONE_RUNTS=2716 del 04/07/2022

# ----------------------------------------------------------------------------
# 6. Backup cifrati sulla Storage Box Hetzner (*)  (INSTALLA.md, passo "Backup")
#    BACKUP_REPOSITORY: sftp:uNNNNNN@uNNNNNN.your-storagebox.de:abc-backup
#    BACKUP_PASSWORD:   password di CIFRATURA dei backup. Comando:
#                       openssl rand -base64 32 | tr -d '\n=+/'
#    ATTENZIONE: custodiscila nel gestore di password di ABC E su carta in sede.
#    Senza questa password i backup NON si possono aprire e nessuno puo' recuperarla.
# ----------------------------------------------------------------------------
BACKUP_REPOSITORY=
BACKUP_PASSWORD=
BACKUP_SSH_PORTA=23
# Ora del backup notturno (ora di Roma)
BACKUP_ORA=03:30

# ----------------------------------------------------------------------------
# 7. Valori tecnici: di norma non si toccano
# ----------------------------------------------------------------------------
DATI_DIR=/mnt/abc-dati
JWT_EXPIRATION=3600
JWT_REMEMBERME_EXPIRATION=2592000
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_SESSION_TTL_HOURS=24
AUDIT_LOG_RETENTION_MONTHS=12

# ----------------------------------------------------------------------------
# 8. Solo per macchine di prova (su Ubuntu NON toccare)
#    I registri dei servizi vanno in journald. Su una macchina senza systemd (per esempio una
#    prova dentro un container) i container non partono: scrivi LOG_DRIVER=json-file.
# ----------------------------------------------------------------------------
# LOG_DRIVER=json-file
